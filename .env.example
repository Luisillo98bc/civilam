# Entrega de formularios (obligatorio en producción)
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_EMAIL=civilamingenieros@gmail.com
RESEND_FROM_EMAIL=CIVILAM Web <web@civilam.com>
RATE_LIMIT_MAX_REQUESTS=5
# Opcional: rate limit compartido entre instancias/serverless con Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL pública definitiva, sin barra final.
NEXT_PUBLIC_SITE_URL=https://www.civilam.com

# Datos legales que deben confirmarse antes de publicar.
COMPANY_LEGAL_NAME=CIVILAM Ingeniería y Construcción
COMPANY_TAX_ID=

# Analítica opcional. Si se omite, no se carga ningún script de Google.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
